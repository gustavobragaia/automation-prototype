{
  "name": "shopee-tracking-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automação de rastreios Shopee -> Shopify via AdsPower",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env start.mjs --painel",
    "rodada": "node --env-file=.env start.mjs",
    "dry": "node --env-file=.env start.mjs --dry",
    "planilha": "node escrever-planilha.mjs --tudo",
    "fixture": "node scripts/gerar-fixture.mjs",
    "importar": "node scripts/importar-planilha.mjs",
    "proof": "node run-proof.mjs",
    "e2e": "node run-e2e.mjs",
    "test": "node scripts/gerar-fixture.mjs && node run-e2e.mjs && node scripts/testar-armazenamento.mjs",
    "contrato": "node scripts/testar-armazenamento.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright-core": "^1.64.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
