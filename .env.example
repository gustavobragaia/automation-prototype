# AdsPower Local API (roda na máquina onde o AdsPower está instalado)
ADSPOWER_BASE=http://local.adspower.net:50325
ADSPOWER_API_KEY=

# inboxes.com via RapidAPI — leitura do código de verificação
RAPIDAPI_KEY=

# Shopify Admin API
SHOPIFY_LOJA=minhaloja.myshopify.com
SHOPIFY_TOKEN=

# Senha única das contas Shopee (em produção: arquivo cifrado, não .env)
SHOPEE_SENHA=

# Janela de pendências da planilha (vazio = tudo)
# PLANILHA_DESDE=2026-10-11   # a partir desta data
# PLANILHA_DIAS=3             # ou os últimos N dias
