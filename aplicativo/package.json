{
  "name": "esteira",
  "productName": "Esteira",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Rastreios da Shopee para a Shopify, na máquina do operador",
  "main": "principal.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "empacotar": "node empacotar/montar-vendor.mjs && electron-builder --mac --publish never",
    "ensaio": "electron ensaio.mjs",
    "ensaio:ajustes": "electron ensaio-ajustes.mjs",
    "ensaio:arranque": "electron ensaio-arranque.mjs",
    "ensaios": "npm run ensaio:arranque && npm run ensaio && npm run ensaio:ajustes && npm run ensaio:chave && npm run ensaio:retry && npm run ensaio:historico && npm run ensaio:progresso && npm run ensaio:escrita",
    "ensaio:chave": "electron ensaio-chave.mjs",
    "ensaio:retry": "electron ensaio-retry.mjs",
    "ensaio:historico": "electron ensaio-historico.mjs",
    "ensaio:progresso": "electron ensaio-progresso.mjs",
    "ensaio:escrita": "electron ensaio-escrita.mjs"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "6.7.3",
    "esbuild": "^0.24.0",
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "cloud.esteira.app",
    "productName": "Esteira",
    "directories": {
      "output": "dist",
      "buildResources": "marca"
    },
    "files": [
      {
        "from": ".",
        "to": "aplicativo",
        "filter": [
          "principal.mjs",
          "preload.cjs",
          "ponte.mjs",
          "tela/**",
          "atualizacao.mjs",
          "vendor/*.cjs"
        ]
      },
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.mjs",
          "vendor/*.cjs",
          "!armazenamento/sqlite.mjs",
          "!armazenamento/sqlite-db.mjs"
        ]
      },
      {
        "from": "../servidor/lib",
        "to": "servidor/lib",
        "filter": [
          "validar.js"
        ]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../extensao",
        "to": "extensao",
        "filter": [
          "**/*",
          "!sessao.js",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../migracoes",
        "to": "migracoes",
        "filter": [
          "**/*.sql"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "marca/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "marca/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gustavobragaia",
        "repo": "esteira-releases"
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extraMetadata": {
      "main": "aplicativo/principal.mjs"
    },
    "dmg": {
      "title": "Esteira ${version}"
    },
    "afterPack": "empacotar/assinar-adhoc.cjs",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Esteira-Setup-${version}.${ext}",
      "shortcutName": "Esteira",
      "createDesktopShortcut": true
    }
  }
}
