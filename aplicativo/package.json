{
  "name": "esteira",
  "productName": "Esteira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rastreios da Shopee para a Shopify, na máquina do operador",
  "main": "principal.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "empacotar": "electron-builder"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cloud.esteira.app",
    "productName": "Esteira",
    "directories": {
      "output": "dist",
      "buildResources": "marca"
    },
    "files": [
      "principal.mjs",
      "preload.cjs",
      "ponte.mjs",
      "tela/**",
      "package.json",
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.mjs"
        ]
      },
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../extensao",
        "to": "extensao",
        "filter": [
          "**/*",
          "!sessao.js",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../migracoes",
        "to": "migracoes",
        "filter": [
          "**/*.sql"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gustavobragaia",
        "repo": "automation-prototype"
      }
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
