{
  "manifest_version": 3,
  "name": "Coletor de Rastreios Shopee",
  "version": "0.1.0",
  "description": "Lê os pedidos da própria tela da Shopee, faz login quando a sessão cai, e envia ao coletor local.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://shopee.com.br/*",
    "https://*.shopee.com.br/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.br/user/purchase*"
      ],
      "js": [
        "coleta.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.com.br/user/purchase*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://shopee.com.br/buyer/login*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}